# SafeSale backend — environment variables.
# Copy to `.env` and fill in. Never commit `.env` or real credentials.

# --- Server ----------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed frontend origins.
FRONTEND_ORIGINS=http://localhost:8080
# Optional regexes for extra origins (e.g. preview deploys). Leave empty if unsure.
FRONTEND_ORIGIN_REGEXES=
# Used to build links in emails.
FRONTEND_APP_URL=http://localhost:8080

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# --- Auth ------------------------------------------------------------------
# At least 32 random characters in production: `openssl rand -base64 48`
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
AUTH_RATE_LIMIT_PER_MIN=10
# Google sign-in. Must be the same client id as the frontend's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# --- Mediator --------------------------------------------------------------
# The mediator signs in on the normal login form with these credentials.
# Login is disabled until MEDIATOR_PASSWORD is set (min 12 characters).
MEDIATOR_EMAIL=mediator@safesale.app
MEDIATOR_PASSWORD=

# --- Payments --------------------------------------------------------------
# mock  = fake pay-in accounts and transfers (local development only)
# nomba = Nomba API
PAYMENT_PROVIDER=mock
# Enables POST /api/dev/simulate-payment. Ignored when NODE_ENV=production.
PAYMENT_SIMULATION=true
# SafeSale fee on released funds, in basis points (150 = 1.5%).
PLATFORM_FEE_BPS=0
# Days after shipping before funds auto-release if the buyer does nothing.
AUTO_RELEASE_DAYS=7

NOMBA_BASE_URL=https://sandbox.nomba.com
NOMBA_CLIENT_ID=
NOMBA_SECRET_KEY=
NOMBA_ACCOUNT_ID=
# Required in production — webhooks are rejected without it.
NOMBA_SIGNING_KEY=

# --- Image uploads -----------------------------------------------------------
# none  = photos are stored inline in the database (works, but not for scale)
# local = saved to STORAGE_LOCAL_DIR and served at /uploads (development only)
# s3    = any S3-compatible bucket: Cloudflare R2, AWS S3, DigitalOcean Spaces,
#         Supabase Storage, Backblaze B2. The bucket/CDN must be publicly readable.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
PUBLIC_API_URL=http://localhost:3000
UPLOAD_MAX_BYTES=5242880
# s3 only:
STORAGE_PUBLIC_URL=
S3_BUCKET=
S3_REGION=auto
# e.g. https://<account-id>.r2.cloudflarestorage.com for Cloudflare R2
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email (Resend) --------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=SafeSale <onboarding@resend.dev>
# With the resend.dev test sender, emails can only go to your own Resend address.
RESEND_TEST_TO_EMAIL=
