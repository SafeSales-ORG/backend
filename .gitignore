# Dependencies
node_modules

# Environment variables — never commit real secrets.
# Only .env.example (placeholders) is tracked.
.env
.env.*
!.env.example

# Keys and certificates
*.pem
*.key
*.p12
*.crt

# Build output
dist
*.tsbuildinfo

# Prisma generated client (regenerated on install)
src/generated

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# Runtime / tests
.cache
coverage

# Local image uploads (STORAGE_PROVIDER=local)
uploads/
.test-uploads/
