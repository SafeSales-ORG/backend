generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EscrowStatus {
  pending_payment
  funded
  shipped
  delivered
  released
  disputed
  refunded
}

enum DisputeStatus {
  direct_resolution
  escalated
  evidence_requested
  mediating
  resolved
}

enum UserRole {
  USER
  MEDIATOR
  ADMIN
}

enum PayoutKind {
  SELLER_RELEASE
  BUYER_REFUND
}

enum PayoutStatus {
  pending // created; transfer not yet confirmed by the provider
  succeeded
  failed // provider rejected it — needs a human
  manual // must be paid out by hand (e.g. buyer refund, no bank details on file)
}

enum AuthProvider {
  EMAIL
  GOOGLE
  FACEBOOK
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String?
  googleId      String?      @unique
  facebookId    String?      @unique
  role          UserRole     @default(USER)
  authProvider  AuthProvider
  emailVerified Boolean      @default(false)
  // Opaque public id (historically a Nostr npub). Also used as Seller.npub.
  nostrNpub     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  seller          Seller?
  orders          Order[]
  disputeMessages DisputeMessage[]
}

model Seller {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  npub     String  @unique
  handle   String  @unique
  name     String
  avatar   String?
  bio      String?
  delivery String?

  bankCode          String
  bankName          String?
  bankAccountNumber String
  bankAccountName   String?

  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings Listing[]
  orders   Order[]

  @@index([handle])
}

model Listing {
  id       String @id @default(cuid())
  sellerId String
  seller   Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  title       String
  description String
  priceNGN    Int
  images      Json
  category    String
  variants    Json?
  inStock     Int     @default(1)
  delivery    String?
  deliveryFee Int?
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([sellerId])
  @@index([active])
}

model Order {
  id         String @id @default(cuid())
  shortId    String @unique
  // Shared reference: seller dashboard + seller-side routes use this.
  orderToken String @unique
  // Buyer's secret (order link + email). Required for buyer-only actions:
  // confirm delivery, release funds, open a dispute as the buyer.
  buyerToken String @unique

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])
  sellerId  String
  seller    Seller  @relation(fields: [sellerId], references: [id])

  buyerId String?
  buyer   User?   @relation(fields: [buyerId], references: [id])

  buyerName       String
  buyerPhone      String?
  buyerEmail      String?
  deliveryAddress String?

  quantity Int     @default(1)
  variant  String?

  // Total the buyer pays (items + delivery), in whole naira.
  priceNGN       Int
  deliveryFeeNGN Int @default(0)

  status EscrowStatus @default(pending_payment)

  // Pay-in account issued by the payment provider for this order.
  accountNumber    String?
  accountName      String?
  bankName         String?
  paymentReference String?   @map("nombaReference")
  paidAmountNGN    Int?
  paidAt           DateTime?

  trackingNumber String?
  carrier        String?

  shippedAt   DateTime?
  deliveredAt DateTime?
  releasedAt  DateTime?
  refundedAt  DateTime?

  autoReleaseAt DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dispute Dispute?
  payouts Payout[]

  @@index([sellerId])
  @@index([status])
  @@index([autoReleaseAt])
}

model WebhookEvent {
  id         String   @id @default(cuid())
  provider   String
  externalId String   @unique
  payload    Json
  status     String
  attempts   Int      @default(0)
  receivedAt DateTime @default(now())
}

model Dispute {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  reason   String
  summary  String?
  openedBy String
  priority String  @default("medium")

  status DisputeStatus @default(direct_resolution)

  directResolutionUntil DateTime?
  evidenceDueAt         DateTime?

  isReturn       Boolean @default(false)
  returnEvidence Json?

  resolution Json?

  messages DisputeMessage[]

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status])
}

model DisputeMessage {
  id        String   @id @default(cuid())
  disputeId String
  dispute   Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@index([disputeId])
  @@index([authorId])
}

// Money leaving escrow. One row per (order, kind): the unique constraint is
// what makes releases and refunds idempotent.
model Payout {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  kind        PayoutKind
  status      PayoutStatus @default(pending)
  amountNGN   Int
  feeNGN      Int          @default(0)
  // Deterministic reference sent to the provider — retries reuse it.
  reference   String       @unique
  providerRef String?
  error       String?
  attempts    Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, kind])
  @@index([status])
}
