{
  "name": "safe-sale-backend",
  "version": "0.1.0",
  "description": "SafeSale backend API — Nomba escrow for Nigerian social commerce. DevCareer x Nomba submission.",
  "type": "module",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "prisma migrate deploy && node dist/src/index.js",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:deploy": "prisma migrate deploy",
    "keys:generate": "tsx scripts/generate-keys.ts",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "nomba",
    "escrow",
    "nigeria",
    "devcareer",
    "hackathon"
  ],
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@nostrify/nostrify": "^0.52.0",
    "@prisma/client": "^6.1.0",
    "@types/node": "^22.10.5",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "nostr-tools": "^2.10.4",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.16"
  }
}
